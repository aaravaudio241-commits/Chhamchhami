{
  "expo": {
    "name": "Chhamchhami",
    "slug": "chhamchhami",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chhamchhami",
    "userInterfaceStyle": "automatic",
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.chhamchhami.app"
    },
    "android": {
      "package": "com.chhamchhami.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
